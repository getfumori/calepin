{
  "name": "calepin-web",
  "version": "0.0.0",
  "private": true,
  "description": "The Calepin Web client.",
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "dev": "vite",
    "build": "pnpm run clean && vite build",
    "typecheck": "vue-tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "build:binary": "pnpm run build && CGO_ENABLED=0 go build -trimpath -ldflags=-s -o bin/calepin ./cmd/calepin",
    "test:e2e": "pnpm run build:binary && playwright test",
    "openapi": "CALEPIN_WRITE_OPENAPI=1 vitest run test/web/openapi.test.ts"
  },
  "dependencies": {
    "@tiptap/core": "3.29.0",
    "@tiptap/extension-list": "3.29.0",
    "@tiptap/markdown": "3.29.0",
    "@tiptap/starter-kit": "3.29.0",
    "@tiptap/vue-3": "3.29.0",
    "vue": "3.5.40",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.8",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.8"
  }
}
