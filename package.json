{
  "name": "fumori-web",
  "version": "0.0.0",
  "private": true,
  "description": "The Fumori Web client.",
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "dev": "vite",
    "build": "pnpm run clean && vite build",
    "typecheck": "vue-tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.tests.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@tiptap/core": "3.29.0",
    "@tiptap/extension-list": "3.29.0",
    "@tiptap/markdown": "3.29.0",
    "@tiptap/starter-kit": "3.29.0",
    "@tiptap/vue-3": "3.29.0",
    "vue": "3.5.40",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@vitejs/plugin-vue": "6.0.8",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.8"
  }
}
